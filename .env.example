SAKALA_HTTP_PORT=8080
SAKALA_HTTPS_PORT=8443

# Nama container dan network runtime. Ubah hanya bila stack ini berjalan di samping
# stack Sakala lain di mesin yang sama; lihat docs/FULL_STACK_LOCAL.md.
# SAKALA_CADDY_CONTAINER=sakala-caddy
# SAKALA_DEMO_CONTAINER=sakala-demo-static
# SAKALA_EDGE_NETWORK=sakala-edge
# SAKALA_RUNTIME_NETWORK=sakala-runtime
# SAKALA_RAILPACK_SANDBOX_TAG=sakala-railpack-sandbox
# COMPOSE_PROJECT_NAME=sakala-infra
# make test-runtime tidak membaca file ini dan memakai port bebas.
# Gunakan SAKALA_TEST_HTTP_PORT dan SAKALA_TEST_HTTPS_PORT bila perlu port tertentu.
